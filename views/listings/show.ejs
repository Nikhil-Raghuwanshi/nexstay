<% layout("/layouts/boilerplate") %>
<script>
  const mapToken = "<%= mapToken %>";
  const coordinates= <%- JSON.stringify(listing.geometry.coordinates) %>
</script>
<div class="container py-4 py-md-5">
  <!-- Listing Header -->

  <div class="listing-header mb-4">
    <div>
      <h1 class="listing-title"><%= listing.title %></h1>
    </div>
  </div>

  <!-- Main Listing Card -->

  <div class="show-card">
    <!-- Image -->
    <div class="show-image-wrapper">
      <img
        src="<%= listing.image.url %>"
        class="show-image"
        alt="<%= listing.title %>"
      />
    </div>

    <!-- Listing Content -->
    <div class="show-content">
      <div class="d-flex justify-content-between align-items-start gap-3">
        <div>
          <p class="text-muted mb-0">
            <i class="fa-solid fa-location-dot me-1"></i>
            <%= listing.location %>, <%= listing.country %>
          </p>

          <!-- Owner -->
          <div class="owner-section">
            <div class="owner-icon">
              <i class="fa-solid fa-user"></i>
            </div>

            <div>
              <small class="text-muted">Hosted by</small>
              <div class="fw-semibold"><%= listing.owner.username %></div>
            </div>
          </div>
        </div>

        <!-- Price -->
        <div class="price-box text-end">
          <h4 class="mb-0">₹ <%= listing.price.toLocaleString("en-IN") %></h4>

          <small class="text-muted">per night</small>
        </div>
      </div>

      <hr class="my-4" />

      <!-- Description -->
      <div class="description-section mt-4">
        <h5 class="fw-semibold mb-2">About this place</h5>

        <p class="show-description"><%= listing.description %></p>
      </div>

      <hr class="my-4" />

      <!-- Actions -->
      <div class="d-flex flex-column flex-sm-row gap-2">
        <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark px-4">
          <i class="fa-solid fa-pen-to-square me-1"></i>
          Edit Listing
        </a>

        <form
          action="/listings/<%= listing._id %>?_method=DELETE"
          method="post"
        >
          <button type="submit" class="btn btn-outline-danger px-4">
            <i class="fa-solid fa-trash me-1"></i>
            Delete Listing
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Reviews Section -->

  <div class="reviews-section mt-5">
    <!-- Review Heading -->
    <div class="section-heading mb-4">
      <h3>
        <i class="fa-solid fa-star"></i>
        Leave a Review
      </h3>

      <p class="text-muted mb-0">Share your experience with other travelers.</p>
    </div>

    <!-- Review Form -->
    <div class="review-form-card">
      <form
        action="/listings/<%= listing._id %>/reviews"
        method="post"
        class="needs-validation"
        novalidate
      >
        <!-- Rating -->
        <div class="mb-3">
          <label class="form-label fw-semibold"> Rating </label>

          <!-- Starability Heartbeat Rating -->
          <fieldset class="starability-heartbeat">
            <input
              type="radio"
              id="no-rate"
              class="input-no-rate"
              name="review[rating]"
              value="1"
              checked
              aria-label="No rating."
            />

            <input
              type="radio"
              id="rate1"
              name="review[rating]"
              value="1"
              required
            />
            <label for="rate1" title="Terrible"> 1 star </label>

            <input type="radio" id="rate2" name="review[rating]" value="2" />
            <label for="rate2" title="Not good"> 2 stars </label>

            <input type="radio" id="rate3" name="review[rating]" value="3" />
            <label for="rate3" title="Average"> 3 stars </label>

            <input type="radio" id="rate4" name="review[rating]" value="4" />
            <label for="rate4" title="Very good"> 4 stars </label>

            <input type="radio" id="rate5" name="review[rating]" value="5" />
            <label for="rate5" title="Amazing"> 5 stars </label>

            <span class="starability-focus-ring"></span>
          </fieldset>

          <div class="invalid-feedback">Please give a rating.</div>
        </div>

        <!-- Comment -->
        <div class="mb-3">
          <label for="comment" class="form-label fw-semibold"> Comment </label>

          <textarea
            name="review[comment]"
            id="comment"
            class="form-control"
            rows="5"
            placeholder="Share your experience..."
            required
          ></textarea>

          <div class="invalid-feedback">Please add a comment.</div>
        </div>

        <!-- Submit -->
        <button type="submit" class="btn btn-dark px-4">
          <i class="fa-solid fa-paper-plane me-1"></i>
          Submit Review
        </button>
      </form>
    </div>

    <!-- All Reviews -->
    <div class="all-reviews mt-5">
      <div class="section-heading mb-4">
        <h3>
          <i class="fa-solid fa-comments"></i>
          All Reviews
        </h3>

        <p class="text-muted mb-0">What other guests are saying.</p>
      </div>

      <div class="review-list">
        <% if (listing.reviews.length === 0) { %>

        <!-- No Reviews -->
        <div class="no-reviews">
          <i class="fa-regular fa-comment-dots"></i>

          <h5>No reviews yet</h5>

          <p class="text-muted mb-0">
            Be the first person to review this listing!
          </p>
        </div>

        <% } else { %>

        <!-- Reviews -->
        <div class="row g-4">
          <% for (let review of listing.reviews) { %>

          <div class="col-12 col-md-6">
            <div class="review-card">
              <!-- Review Author -->
              <div class="review-author">
                <div class="review-author-icon">
                  <i class="fa-solid fa-user"></i>
                </div>

                <h4><%= review.author.username %></h4>
              </div>

              <!-- Rating -->
              <div class="review-rating mb-2">
                <% for (let i = 1; i <= 5; i++) { %> <% if (i <= review.rating)
                { %>

                <i class="fa-solid fa-star"></i>

                <% } else { %>

                <i class="fa-regular fa-star"></i>

                <% } %> <% } %>
              </div>

              <!-- Comment -->
              <p class="review-comment"><%= review.comment %></p>

              <!-- Delete Review -->
              <form
                action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                method="post"
              >
                <button type="submit" class="btn btn-sm btn-outline-danger">
                  <i class="fa-solid fa-trash me-1"></i>
                  Delete
                </button>
              </form>
            </div>
          </div>

          <% } %>
        </div>

        <% } %>
      </div>
    </div>
  </div>
  <div class="map-section mt-5">
    <h3>Where you’ll be</h3>
    <p><%=listing.location%>, <strong><%=listing.country%></strong></p>
    <div id="map" class="mt-3"></div>
  </div>
</div>

<script src="/JS/map.js"></script>
