<% layout("/layouts/boilerplate") %>
<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0 fw-semibold"><i>Book Now...</i></h3>
  </div>

  <div class="row g-4">
    <% for (let listing of allListings) { %>

    <div class="col-12 col-sm-6 col-md-4 col-lg-3">
      <a href="/listings/<%= listing._id %>" class="listing-link">
        <div class="card listing-card h-100 border-0">
          <div class="listing-image-container">
            <img
              src="<%= listing.image.url %>"
              class="card-img-top listing-image"
              alt="<%= listing.title %>"
            />
          </div>

          <div class="card-body px-1 pt-3">
            <h5 class="card-title mb-1"><%= listing.title %></h5>

            <p class="card-text text-muted mb-1">
              <%= listing.location %>, <%= listing.country %>
            </p>

            <p class="card-text mb-0">
              <strong> ₹ <%= listing.price.toLocaleString("en-IN") %> </strong>
              <span class="text-muted"> / night</span>
            </p>
          </div>
        </div>
      </a>
    </div>

    <% } %>
  </div>
</div>
