<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Nexstay</title>

    <!-- Bootstrap -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <!-- Font Awesome -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
    />

    <!-- Landing Page CSS -->
    <link rel="stylesheet" href="/CSS/landing1.css" />
    <link rel="stylesheet" href="CSS/landing.css" />
  </head>
  <body>
    <!-- ================= NAVBAR ================= -->

    <nav class="navbar navbar-expand-lg bg-white border-bottom sticky-top">
      <div class="container-fluid px-4">
        <!-- Logo -->
        <a class="navbar-brand fw-bold text-danger" href="/">
          <i class="fa-solid fa-house"></i>
          Nexstay
        </a>

        <!-- Mobile Toggle -->
        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#landingNavbar"
          aria-controls="landingNavbar"
          aria-expanded="false"
          aria-label="Toggle navigation"
        >
          <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Navbar Content -->
        <div class="collapse navbar-collapse" id="landingNavbar">
          <!-- Left Side -->
          <ul class="navbar-nav me-auto mb-2 mb-lg-0">
            <li class="nav-item">
              <a class="nav-link" href="/listings">
                <i class="fa-solid fa-house me-1"></i>
                Home
              </a>
            </li>

            <li class="nav-item">
              <a class="nav-link" href="/listings">
                <i class="fa-solid fa-compass me-1"></i>
                All Listings
              </a>
            </li>

            <% if (typeof currentUser !== "undefined" && currentUser) { %>

            <li class="nav-item">
              <a class="nav-link" href="/listings/new">
                <i class="fa-solid fa-plus me-1"></i>
                Add Listing
              </a>
            </li>

            <% } %>
          </ul>

          <!-- Right Side -->
          <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
            <% if (typeof currentUser !== "undefined" && currentUser) { %>

            <li class="nav-item">
              <span class="nav-link">
                <i class="fa-solid fa-user me-1"></i>
                <%= currentUser.username %>
              </span>
            </li>

            <li class="nav-item">
              <a class="nav-link" href="/logout">
                <i class="fa-solid fa-right-from-bracket me-1"></i>
                Logout
              </a>
            </li>

            <% } else { %>

            <li class="nav-item">
              <a class="nav-link" href="/login">
                <i class="fa-solid fa-right-to-bracket me-1"></i>
                Login
              </a>
            </li>

            <li class="nav-item">
              <a class="nav-link" href="/signup">
                <i class="fa-solid fa-user-plus me-1"></i>
                Sign Up
              </a>
            </li>

            <% } %>
          </ul>
        </div>
      </div>
    </nav>

    <!-- ================= LANDING PAGE CONTENT ================= -->

    <main>
      <div class="nexstay-home">
        <!-- =========================
         HERO SECTION
    ========================== -->

        <section class="hero">
          <div class="hero-background">
            <div class="hero-orb orb-one"></div>
            <div class="hero-orb orb-two"></div>
          </div>

          <div class="hero-container">
            <!-- LEFT CONTENT -->
            <div class="hero-content">
              <div class="hero-eyebrow">
                <span class="eyebrow-dot"></span>
                Discover your next stay
              </div>

              <h1 class="hero-title">
                Stay somewhere
                <span>worth remembering.</span>
              </h1>

              <p class="hero-description">
                Discover beautiful places, explore new destinations, and find a
                stay that feels like home.
              </p>

              <!-- SEARCH BOX -->

              <form action="/listings/search" method="GET" class="hero-search">
                <div class="search-field">
                  <i class="fa-solid fa-location-dot"></i>

                  <div>
                    <small>Where</small>
                    <input
                      type="text"
                      name="location"
                      placeholder="Search destinations"
                    />
                  </div>
                </div>

                <div class="search-divider"></div>

                <button type="submit" class="search-button">
                  <i class="fa-solid fa-magnifying-glass"></i>
                  <span>Search</span>
                </button>
              </form>

              <!-- QUICK INFO -->

              <div class="hero-trust">
                <div class="trust-item">
                  <i class="fa-solid fa-circle-check"></i>
                  <span>Verified listings</span>
                </div>

                <div class="trust-item">
                  <i class="fa-solid fa-map-location-dot"></i>
                  <span>Interactive maps</span>
                </div>

                <div class="trust-item">
                  <i class="fa-solid fa-shield-halved"></i>
                  <span>Secure accounts</span>
                </div>
              </div>
            </div>

            <!-- RIGHT VISUAL -->

            <div class="hero-visual">
              <% if (listings && listings.length > 0) { %>

              <div class="hero-image-main">
                <img
                  src="<%= listings[0].image?.url || listings[0].image %>"
                  alt="<%= listings[0].title %>"
                />

                <div class="image-overlay"></div>

                <!-- IMAGE LABEL -->

                <div class="image-location">
                  <i class="fa-solid fa-location-dot"></i>

                  <div>
                    <strong> <%= listings[0].location %> </strong>

                    <span>
                      <% if (listings[0].country) { %> <%= listings[0].country
                      %> <% } %>
                    </span>
                  </div>
                </div>

                <!-- RATING -->

                <div class="image-rating">
                  <i class="fa-solid fa-star"></i>
                  <strong>4.8</strong>
                  <span>Guest rating</span>
                </div>
              </div>

              <!-- FLOATING IMAGE -->

              <% if (listings.length > 1) { %>

              <div class="hero-floating-card">
                <img
                  src="<%= listings[1].image?.url || listings[1].image %>"
                  alt="<%= listings[1].title %>"
                />

                <div class="floating-card-info">
                  <small>Popular stay</small>

                  <strong> <%= listings[1].title %> </strong>

                  <span>
                    ₹<%= Number(listings[1].price).toLocaleString("en-IN") %> /
                    night
                  </span>
                </div>

                <i class="fa-solid fa-arrow-up-right-from-square"></i>
              </div>

              <% } %>

              <!-- DECORATIVE CIRCLE -->

              <div class="hero-circle">
                <span>N</span>
              </div>

              <% } %>
            </div>
          </div>
        </section>

        <!-- =========================
         FEATURED LISTINGS
    ========================== -->

        <section class="featured-section">
          <div class="section-container">
            <div class="section-header">
              <div>
                <span class="section-label"> EXPLORE </span>

                <h2>Places made for your next escape</h2>

                <p>Browse some of the stays available on Nexstay.</p>
              </div>

              <a href="/listings" class="view-all">
                View all listings
                <i class="fa-solid fa-arrow-right"></i>
              </a>
            </div>

            <div class="listing-grid">
              <% listings.slice(0, 6).forEach((listing, index) => { %>

              <a
                href="/listings/<%= listing._id %>"
                class="listing-card"
                style="--delay: <%= index * 0.08 %>s"
              >
                <div class="listing-image">
                  <img
                    src="<%= listing.image?.url || listing.image %>"
                    alt="<%= listing.title %>"
                    loading="lazy"
                  />

                  <div class="listing-gradient"></div>

                  <span class="listing-badge">
                    <i class="fa-solid fa-sparkles"></i>
                    Featured
                  </span>

                  <div class="listing-heart">
                    <i class="fa-regular fa-heart"></i>
                  </div>
                </div>

                <div class="listing-details">
                  <div class="listing-top">
                    <h3><%= listing.title %></h3>

                    <span class="rating">
                      <i class="fa-solid fa-star"></i>
                      4.8
                    </span>
                  </div>

                  <p class="listing-location">
                    <i class="fa-solid fa-location-dot"></i>

                    <%= listing.location %> <% if (listing.country) { %> , <%=
                    listing.country %> <% } %>
                  </p>

                  <div class="listing-bottom">
                    <span class="price">
                      ₹<%= Number(listing.price).toLocaleString("en-IN") %>
                      <small>/ night</small>
                    </span>

                    <span class="arrow-circle">
                      <i class="fa-solid fa-arrow-up-right"></i>
                    </span>
                  </div>
                </div>
              </a>

              <% }) %>
            </div>
          </div>
        </section>

        <!-- =========================
         WHY NEXSTAY
    ========================== -->

        <section class="why-section">
          <div class="section-container">
            <div class="why-layout">
              <!-- LEFT -->

              <div class="why-content">
                <span class="section-label"> WHY NEXSTAY </span>

                <h2>Everything you need to discover a better stay.</h2>

                <p>
                  Nexstay brings listings, maps, reviews and user accounts
                  together in one simple experience.
                </p>

                <a href="/listings" class="dark-button">
                  Explore Nexstay
                  <i class="fa-solid fa-arrow-right"></i>
                </a>
              </div>

              <!-- RIGHT FEATURES -->

              <div class="feature-list">
                <div class="feature-item">
                  <div class="feature-icon">
                    <i class="fa-solid fa-compass"></i>
                  </div>

                  <div>
                    <h3>Discover new places</h3>

                    <p>
                      Explore listings and find stays that match your
                      destination.
                    </p>
                  </div>
                </div>

                <div class="feature-item">
                  <div class="feature-icon">
                    <i class="fa-solid fa-map-location-dot"></i>
                  </div>

                  <div>
                    <h3>Explore with maps</h3>

                    <p>Understand exactly where your property is located.</p>
                  </div>
                </div>

                <div class="feature-item">
                  <div class="feature-icon">
                    <i class="fa-solid fa-comments"></i>
                  </div>

                  <div>
                    <h3>Share your experience</h3>

                    <p>Read and share reviews with the Nexstay community.</p>
                  </div>
                </div>

                <div class="feature-item">
                  <div class="feature-icon">
                    <i class="fa-solid fa-house-circle-check"></i>
                  </div>

                  <div>
                    <h3>Manage your listings</h3>

                    <p>Create, edit and manage your properties with ease.</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- =========================
         HOW IT WORKS
    ========================== -->

        <section class="steps-section">
          <div class="section-container">
            <div class="section-header centered">
              <span class="section-label"> SIMPLE PROCESS </span>

              <h2>Your journey starts in three steps.</h2>

              <p>Finding your next stay doesn't have to be complicated.</p>
            </div>

            <div class="steps-grid">
              <div class="step-card">
                <span class="step-number"> 01 </span>

                <div class="step-icon">
                  <i class="fa-solid fa-magnifying-glass"></i>
                </div>

                <h3>Search</h3>

                <p>Search for properties based on your preferred location.</p>
              </div>

              <div class="step-card">
                <span class="step-number"> 02 </span>

                <div class="step-icon">
                  <i class="fa-solid fa-map"></i>
                </div>

                <h3>Explore</h3>

                <p>
                  View listings, locations, prices and reviews before choosing.
                </p>
              </div>

              <div class="step-card">
                <span class="step-number"> 03 </span>

                <div class="step-icon">
                  <i class="fa-solid fa-house"></i>
                </div>

                <h3>Stay</h3>

                <p>Find a place that feels right for your next adventure.</p>
              </div>
            </div>
          </div>
        </section>

        <!-- =========================
         CTA
    ========================== -->

        <section class="cta-section">
          <div class="cta-glow"></div>

          <div class="cta-content">
            <span class="section-label light"> YOUR NEXT ADVENTURE </span>

            <h2>
              There's a new place<br />
              waiting for you.
            </h2>

            <p>Explore Nexstay and discover somewhere worth staying.</p>
          </div>

          <a href="/listings" class="cta-button">
            Explore listings

            <i class="fa-solid fa-arrow-right"></i>
          </a>
        </section>
      </div>
    </main>

    <!-- ================= FOOTER ================= -->

    <footer class="footer mt-5">
      <div class="container">
        <div class="row py-5">
          <!-- Brand -->
          <div class="col-lg-4 col-md-6 mb-4">
            <h4 class="fw-bold text-danger">
              <i class="fa-solid fa-house"></i>
              Nexstay
            </h4>

            <p class="text-muted">
              Discover unique stays, explore new destinations, and make every
              journey memorable with Nexstay.
            </p>
          </div>

          <!-- Quick Links -->
          <div class="col-lg-2 col-md-6 mb-4">
            <h6 class="fw-bold">Quick Links</h6>

            <a href="/" class="footer-link">Home</a>
            <a href="/listings" class="footer-link">All Listings</a>

            <% if (typeof currentUser !== "undefined" && currentUser) { %>
            <a href="/listings/new" class="footer-link"> Add Listing </a>
            <% } %>
          </div>

          <!-- Support -->
          <div class="col-lg-3 col-md-6 mb-4">
            <h6 class="fw-bold">Support</h6>

            <a href="/privacyTermsHelp/privacy" class="footer-link">
              Privacy
            </a>

            <a href="/privacyTermsHelp/terms" class="footer-link"> Terms </a>

            <a href="/privacyTermsHelp/help" class="footer-link"> Help </a>
          </div>

          <!-- Social Media -->
          <div class="col-lg-3 col-md-6 mb-4">
            <h6 class="fw-bold">Follow Us</h6>

            <div class="social-links">
              <a href="#" aria-label="Instagram">
                <i class="fa-brands fa-instagram"></i>
              </a>

              <a href="#" aria-label="Facebook">
                <i class="fa-brands fa-facebook"></i>
              </a>

              <a href="#" aria-label="LinkedIn">
                <i class="fa-brands fa-linkedin"></i>
              </a>

              <a href="#" aria-label="GitHub">
                <i class="fa-brands fa-github"></i>
              </a>
            </div>
          </div>
        </div>

        <!-- Bottom Footer -->
        <div class="footer-bottom border-top py-3">
          <div class="row">
            <div class="col-md-6 text-center text-md-start">
              <p class="mb-0">© 2026 Nexstay. All rights reserved.</p>
            </div>

            <div class="col-md-6 text-center text-md-end">
              <p class="mb-0">Made with ❤️ for travelers</p>
            </div>
          </div>
        </div>
      </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
